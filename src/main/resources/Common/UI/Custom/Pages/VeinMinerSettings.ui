$C = "../Common.ui";

// Selected uses the native disabled appearance while all button states remain interactive.
@SelectedButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: $C.@ButtonBorder), LabelStyle: $C.@SmallButtonDisabledLabelStyle),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: $C.@ButtonBorder), LabelStyle: $C.@SmallButtonDisabledLabelStyle),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: $C.@ButtonBorder), LabelStyle: $C.@SmallButtonDisabledLabelStyle)
);

@CardButtonStyle = ButtonStyle(
  Default: (Background: #1c2836),
  Hovered: (Background: #30465e),
  Pressed: (Background: #3b536b)
);
@SelectedCardButtonStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: $C.@ButtonBorder)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: $C.@ButtonBorder)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: $C.@ButtonBorder))
);

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 980, Height: 680);
  #Title { $C.@Title #PageHeading { @Text = "ADVENCED VEIN MINING · SETTINGS"; } }
  #Content {
    Padding: (Full: 20);
    LayoutMode: Top;
    Group {
      Anchor: (Height: 480);
      LayoutMode: Left;
      Group {
        Anchor: (Width: 630, Right: 20);
        LayoutMode: Top;
        Group #CatalogTabs {
          Anchor: (Height: 36, Bottom: 8);
          LayoutMode: Left;
          $C.@SmallSecondaryTextButton #BlocksTab { FlexWeight: 1; Anchor: (Height: 34, Right: 4); Text: "Blocks"; }
          $C.@SmallSecondaryTextButton #ToolsTab { FlexWeight: 1; Anchor: (Height: 34, Left: 4); Text: "Tools"; }
        }
        $C.@TextField #Search {
          Anchor: (Height: 38, Bottom: 8);
          PlaceholderText: "Search by name or ID...";
        }
        Group {
          Anchor: (Height: 28, Bottom: 8);
          LayoutMode: Left;
          Label #CatalogTitle {
            FlexWeight: 1;
            Style: (FontSize: 14, RenderBold: true, TextColor: #d3dee3, VerticalAlignment: Center);
          }
          $C.@SmallSecondaryTextButton #Filter { Anchor: (Width: 180, Height: 26); Text: "All"; }
        }
        Group #CatalogScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #PlayerColumns {
            Visible: false;
            Anchor: (Height: 26);
            LayoutMode: Left;
            Label #PlayerNameColumn { FlexWeight: 1; Anchor: (Right: 10); Style: (FontSize: 12, HorizontalAlignment: Center, TextColor: #a8b6c6); }
            Label #ModifyColumn { Anchor: (Width: 86); Style: (FontSize: 12, HorizontalAlignment: Center, TextColor: #a8b6c6); }
            Label #ReadonlyColumn { Anchor: (Width: 86); Style: (FontSize: 12, HorizontalAlignment: Center, TextColor: #a8b6c6); }
          }
          Group #Grid { LayoutMode: Top; }
        }
      }
      Group {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Group #GeneralSettings {
          Anchor: (Height: 350);
          LayoutMode: Top;
          Label #RangeSection {
            Anchor: (Height: 30);
            Text: "RANGE AND ACTIVATION";
            Style: (FontSize: 16, RenderBold: true, TextColor: #d3dee3);
          }
          Label #RangeTitle { Text: "Maximum distance (blocks)"; Anchor: (Height: 26); Style: (FontSize: 14, TextColor: #d3dee3); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 38);
            $C.@SmallSecondaryTextButton #RadiusMinus { Anchor: (Width: 36, Height: 36, Right: 8); Text: "-"; }
            $C.@NumberField #Radius {
              FlexWeight: 1;
              Anchor: (Height: 36, Right: 8);
              Format: (MaxDecimalPlaces: 0, Step: 1, MinValue: 1, MaxValue: 32);
              Value: 8;
            }
            $C.@SmallSecondaryTextButton #RadiusPlus { Anchor: (Width: 36, Height: 36); Text: "+"; }
          }
          Label #RangeHint {
            Anchor: (Height: 48, Top: 8, Bottom: 12);
            Text: "Enter 1 to 32. The radius starts at the first block. Up to 32 blocks per vein.";
            Style: (FontSize: 13, Wrap: true, TextColor: #a8b6c6);
          }
          Label #ActivationTitle { Text: "Activation action"; Anchor: (Height: 26); Style: (FontSize: 14, TextColor: #d3dee3); }
          Button #Activation {
            Anchor: (Height: 38);
            LayoutMode: Left;
            Padding: (Horizontal: 12, Vertical: 8);
            Background: #25364a;
            Style: (Hovered: (Background: #30465e), Pressed: (Background: #3b536b));
            Label #ActivationName { Style: (FontSize: 14, VerticalAlignment: Center, TextColor: #d3dee3); }
            HotkeyLabel #ActivationKey {
              InputBindingKey: "Crouch";
            }
            Label { Text: ")"; Style: (FontSize: 14, VerticalAlignment: Center, TextColor: #d3dee3); }
            Group { FlexWeight: 1; }
            Label { Text: ">"; Style: (FontSize: 14, VerticalAlignment: Center, TextColor: #d3dee3); }
          }
          Label #ActivationHint { Anchor: (Height: 56, Top: 8); Style: (FontSize: 14, Wrap: true, TextColor: #d3dee3); }
          Label #ControlsHint {
            Anchor: (Height: 68, Bottom: 12);
            Text: "The key follows your controls. Set crouch to hold. Walking and sprinting require movement.";
            Style: (FontSize: 12, Wrap: true, TextColor: #a8b6c6);
          }
        }
        Group #ToolSettings {
          Visible: false;
          Anchor: (Height: 420);
          LayoutMode: Top;
          Label #ToolHeading { Anchor: (Height: 30); Style: (FontSize: 16, RenderBold: true, TextColor: #d3dee3); }
          ItemIcon #ToolPreview { Anchor: (Width: 80, Height: 80, Bottom: 8); }
          Label #ToolName { Anchor: (Height: 44); Style: (FontSize: 14, Wrap: true, TextColor: #d3dee3); }
          Group {
            Anchor: (Height: 34, Bottom: 16);
            LayoutMode: Left;
            $C.@CheckBox #ToolEnabled { Anchor: (Width: 22, Height: 22, Right: 10); }
            Label #ToolEnabledLabel { FlexWeight: 1; Anchor: (Height: 26); Style: (FontSize: 14, TextColor: #d3dee3); }
          }
          Label #ToolTypeLabel { Anchor: (Height: 30); Style: (FontSize: 14, TextColor: #d3dee3); }
          $C.@SmallSecondaryTextButton #ModeOres { Anchor: (Height: 36, Bottom: 8); Text: "Ores"; }
          $C.@SmallSecondaryTextButton #ModeLogs { Anchor: (Height: 36, Bottom: 8); Text: "Logs"; }
          $C.@SmallSecondaryTextButton #ModeAll { Anchor: (Height: 36, Bottom: 8); Text: "Everything"; }
          Label #ToolHint { Anchor: (Height: 36, Bottom: 8); Style: (FontSize: 12, Wrap: true, TextColor: #a8b6c6); }
        }
        Group #PermissionsHelp {
          Visible: false;
          Anchor: (Height: 370);
          LayoutMode: Top;
          Label #PermissionsHeading { Anchor: (Height: 40); Style: (FontSize: 16, Wrap: true, RenderBold: true, TextColor: #d3dee3); }
          Label #PermissionsHint { Anchor: (Height: 170); Style: (FontSize: 14, Wrap: true, TextColor: #a8b6c6); }
          Label #CommandAccessTitle { Anchor: (Height: 30); Style: (FontSize: 14, TextColor: #d3dee3); }
          Group {
            Anchor: (Height: 38, Bottom: 8);
            LayoutMode: Left;
            $C.@SmallSecondaryTextButton #CommandAdminOnly { FlexWeight: 1; Anchor: (Height: 36, Right: 8); Text: "Admin only"; }
            $C.@SmallSecondaryTextButton #CommandAll { FlexWeight: 1; Anchor: (Height: 36); Text: "All"; }
          }
          Label #CommandAccessHint { Anchor: (Height: 80); Style: (FontSize: 12, Wrap: true, TextColor: #a8b6c6); }
        }
        Label #Summary { Anchor: (Height: 26); Style: (FontSize: 13, Wrap: true, TextColor: #d3dee3); }
        Label #ReadOnlyNotice { Visible: false; Anchor: (Height: 40); Style: (FontSize: 13, Wrap: true, TextColor: #e9c77b); }
        $C.@SmallSecondaryTextButton #Players { Anchor: (Height: 32, Bottom: 8); Text: "Player permissions"; }
        Group #ListActions {
          Anchor: (Height: 32);
          LayoutMode: Left;
          $C.@SmallSecondaryTextButton #Defaults { FlexWeight: 1; Anchor: (Height: 30, Right: 8); Text: "Defaults"; }
          $C.@SmallSecondaryTextButton #Clear { FlexWeight: 1; Anchor: (Height: 30); Text: "Clear"; }
        }
      }
    }
    Group {
      Anchor: (Height: 84, Top: 12);
      LayoutMode: Left;
      Group { Anchor: (Width: 630, Right: 20); }
      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Group {
          Anchor: (Height: 40);
          LayoutMode: Left;
          Group { FlexWeight: 1; Anchor: (Right: 8); }
          Label #Status {
            FlexWeight: 2;
            Anchor: (Height: 32);
            Style: (FontSize: 12, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: End, TextColor: #e9c77b);
          }
        }
        Group {
          Anchor: (Height: 44);
          LayoutMode: Left;
          $C.@SmallSecondaryTextButton #Cancel { FlexWeight: 1; Anchor: (Height: 40, Right: 8); Text: "Close"; }
          $C.@TextButton #Save { FlexWeight: 2; Anchor: (Height: 40); Text: "Save"; }
        }
      }
    }
  }
}
